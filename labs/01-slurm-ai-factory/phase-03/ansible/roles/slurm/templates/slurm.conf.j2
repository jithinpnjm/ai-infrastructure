# Managed by Ansible. Do not edit manually on GPU workers.
# The controller remains the source of truth for cluster policy.

ClusterName={{ slurm_cluster_name }}
SlurmctldHost={{ slurm_controller_host }}({{ slurm_controller_addr }})
SlurmctldPort={{ slurmctld_port }}
SlurmdPort={{ slurmd_port }}

AuthType=auth/munge
SlurmUser=slurm

SlurmdSpoolDir={{ slurm_spool_dir }}
SlurmdLogFile={{ slurm_log_dir }}/slurmd.log
SlurmdPidFile=/run/slurmd.pid

ProctrackType=proctrack/cgroup
TaskPlugin=task/cgroup,task/affinity

SelectType=select/cons_tres
SelectTypeParameters=CR_CORE_MEMORY
GresTypes=gpu

# Keep the accounting configuration aligned with the controller-side cluster.
AccountingStorageType=accounting_storage/slurmdbd
AccountingStorageHost={{ slurm_controller_addr }}
AccountingStoragePort=6819

{% for host in groups['gpu_workers'] %}
NodeName={{ host }} NodeAddr={{ hostvars[host].ansible_host | default(host) }} CPUs={{ hostvars[host].slurm_node_cpus | default(hostvars[host].ansible_processor_vcpus) }} RealMemory={{ hostvars[host].slurm_node_real_memory_mb | default(hostvars[host].ansible_memtotal_mb) }} Gres=gpu:{{ hostvars[host].slurm_gpu_type | default(slurm_gpu_type) }}:{{ hostvars[host].slurm_gpu_count | default(slurm_gpu_count) }} State=UNKNOWN
{% endfor %}

PartitionName=gpu Nodes={{ groups['gpu_workers'] | join(',') }} Default=YES State=UP
